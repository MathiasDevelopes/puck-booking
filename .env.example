# App Configuration
PROJECT_NAME=Hockey Booking API
VERSION=1.0.0
API_V1_STR=/api/v1

# Database
DATABASE_URL=sqlite:///./hockey_booking.db

# Security - CHANGE THESE IN PRODUCTION!
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External API
HOCKEY_API_URL=https://oilers.hockeydata.no/live/match?provider=automatic

# Booking Configuration
MAX_BOOKINGS_PER_MATCH=2

# CORS - Configure allowed origins (comma-separated or "*" for all)
CORS_ORIGINS=*
